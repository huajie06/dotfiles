# Font
font-family = JetBrains Mono
font-size = 14

# Theme
theme = tokyo-night

# Window
background-opacity = 0.93
window-padding-x = 8
window-padding-y = 4
macos-titlebar-style = tabs
confirm-close-surface = false

# Cursor
cursor-style = bar
cursor-style-blink = true

# Shell
shell-integration = fish

# Mouse
mouse-hide-while-typing = true

# Copy-on-select
copy-on-select = clipboard
